// Despliegue en Cloudflare Workers (solo assets estáticos, sin código de Worker).
// Build:   npm ci && npm run build
// Deploy:  npx wrangler deploy
// Netlify (netlify.toml) sigue funcionando en paralelo durante la migración.
{
  "name": "livesync-manual",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
